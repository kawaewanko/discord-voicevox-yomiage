# Discord Developer Portal の Bot Token（秘密情報）
DISCORD_TOKEN=
# アプリケーションID
CLIENT_ID=
# 任意のギルドコマンド登録先（省略時は setup.sh がBot参加サーバーを検出）
GUILD_ID=
# ローカル実行時のVOICEVOX Engine URL（Composeでは自動的にvoicevoxへ上書き）
VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOXのデフォルト話者スタイルID
DEFAULT_SPEAKER=3
# Bot内部のヘルスチェックHTTPポート
PORT=3000
# メンテナンスモード（true / false）。trueの間は読み上げ・接続・設定変更を停止
MAINTENANCE_MODE=false
# メンテナンス中にコマンドへ表示する案内文
MAINTENANCE_MESSAGE=現在メンテナンス中のため、読み上げ機能を停止しています。しばらくお待ちください。
# 複数Botで共有するメンテナンス状態ボリューム名（全Botで同じ値にする）
MAINTENANCE_STATE_VOLUME=discord-voicevox-yomiage-maintenance
# ホストへ公開するヘルスチェックポート（Compose用）
HEALTH_PORT=3000
# ローカル実行時のギルド設定保存先 / Composeでは/app/dataへ上書き
DATA_DIR=./data
# Composeのコンテナ・ボリューム名の接頭辞
COMPOSE_PROJECT_NAME=discord-voicevox-yomiage
# CDで公開したBotイメージを使う場合に設定（未設定時はローカルビルド）
BOT_IMAGE=discord-voicevox-yomiage/bot:local
# VOICEVOX CPUスレッド数
VV_CPU_NUM_THREADS=2
# VOICEVOX公式ベースイメージ（x86_64: cpu-latest / ARM64: cpu-arm64-latest）
VOICEVOX_BASE_IMAGE=voicevox/voicevox_engine:cpu-latest

# 複数Bot設定（setup-multi.sh が BOT_1〜BOT_10 の値を対話式に追加します）
# BOT_N_DISCORD_TOKEN=
# BOT_N_CLIENT_ID=
# BOT_N_GUILD_ID=
# BOT_N_HEALTH_PORT=300N
# BOT_N_MAINTENANCE_MODE=false
