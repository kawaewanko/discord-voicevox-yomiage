# Discord Developer Portal の Bot Token（秘密情報）
DISCORD_TOKEN=
# アプリケーションID
CLIENT_ID=
# テスト用サーバーID（ギルドコマンド登録先）
GUILD_ID=
# ローカル実行時のVOICEVOX Engine URL（Composeでは自動的にvoicevoxへ上書き）
VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOXのデフォルト話者スタイルID
DEFAULT_SPEAKER=3
# Bot内部のヘルスチェックHTTPポート
PORT=3000
# ホストへ公開するヘルスチェックポート（Compose用）
HEALTH_PORT=3000
# ローカル実行時のギルド設定保存先 / Composeでは/app/dataへ上書き
DATA_DIR=./data
# Composeのコンテナ・ボリューム名の接頭辞
COMPOSE_PROJECT_NAME=discord-voicevox-yomiage
# CDで公開したBotイメージを使う場合に設定（未設定時はローカルビルド）
BOT_IMAGE=discord-voicevox-yomiage/bot:local
# VOICEVOX CPUスレッド数
VV_CPU_NUM_THREADS=2
# VOICEVOX公式ベースイメージ（x86_64: cpu-latest / ARM64: cpu-arm64-latest）
VOICEVOX_BASE_IMAGE=voicevox/voicevox_engine:cpu-latest
